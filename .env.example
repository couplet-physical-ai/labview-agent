# Template only; these values cannot connect. Copy to .env and replace all values.
# For a local broker without .env, code defaults to localhost:5672 / guest.
RABBITMQ_HOST=broker.example.invalid
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-me
RABBITMQ_PASS=replace-me
# Explicit opt-in only: absolute path to an independently reviewed policy.
LV_COMMAND_POLICY=/path/to/reviewed-policy.toml
